# 이 파일을 복사해서 같은 폴더에 .env.local 로 저장한 뒤 키를 채운다
# .env.local 은 비밀 키가 들어가므로 절대 공유 · 업로드하지 말 것
# 값은 모두 Supabase 대시보드 → Project Settings → API Keys → Legacy API Keys 탭에 있음

# 프로젝트 URL
SUPABASE_URL=https://zykkrfqeutjukffryjeu.supabase.co

# anon (public) 키 — 조회용
SUPABASE_ANON_KEY=

# service_role (secret) 키 — 추가 · 삭제용. RLS를 무시하므로 서버에만 둘 것
SUPABASE_SERVICE_ROLE_KEY=

# PORT=3000
