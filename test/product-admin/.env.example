# 이 파일을 복사해서 같은 폴더에 .env.local 로 저장한 뒤 값을 채운다
# .env.local 은 비밀 키가 들어가므로 절대 공유 · 업로드하지 말 것
# Vercel에 배포할 때는 같은 이름 · 값을 Vercel 프로젝트의 Environment Variables에 넣는다
# Supabase 값은 모두 대시보드 → Project Settings → API Keys → Legacy API Keys 탭에 있음

# 프로젝트 URL
SUPABASE_URL=https://zykkrfqeutjukffryjeu.supabase.co

# anon (public) 키 — 조회용
SUPABASE_ANON_KEY=

# service_role (secret) 키 — 추가 · 삭제용. RLS를 무시하므로 서버에만 둘 것
SUPABASE_SERVICE_ROLE_KEY=

# 관리자 비밀번호 — 이 비밀번호로 로그인해야 추가 · 삭제 가능. 비어 있으면 추가 · 삭제가 잠김
# 다른 곳에서 쓰지 않는 길고 새로운 비밀번호로 정할 것
ADMIN_PASSWORD=

# PORT=3000
